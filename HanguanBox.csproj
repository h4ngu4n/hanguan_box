<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>HanguanBox</RootNamespace>
    <AssemblyName>HanguanBox</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2"/>
    <PackageReference Include="MaterialDesignThemes" Version="5.2.1"/>
  </ItemGroup>

  <ItemGroup>
    <!-- 将 MCL.core.dll 内嵌进程序集；文件不存在时不打断编译 -->
    <EmbeddedResource Include="Assets\MCL.core.dll" LogicalName="MCL.core.dll"
                      Condition="Exists('Assets\MCL.core.dll')"/>
    <!-- 服务器 native 转发：内嵌 injector.exe + MinecraftProxy.dll，运行时释放到软件目录 -->
    <EmbeddedResource Include="Assets\prxy\injector.exe" LogicalName="prxy/injector.exe"
                      Condition="Exists('Assets\prxy\injector.exe')"/>
    <EmbeddedResource Include="Assets\prxy\MinecraftProxy.dll" LogicalName="prxy/MinecraftProxy.dll"
                      Condition="Exists('Assets\prxy\MinecraftProxy.dll')"/>
    <!-- 客户端注入：内嵌 Vape421Injector.exe + Vape421Native.dll，运行时释放到软件目录 -->
    <EmbeddedResource Include="vape\Vape421Injector.exe" LogicalName="vape/Vape421Injector.exe"
                      Condition="Exists('vape\Vape421Injector.exe')"/>
    <EmbeddedResource Include="vape\Vape421Native.dll" LogicalName="vape/Vape421Native.dll"
                      Condition="Exists('vape\Vape421Native.dll')"/>
    <!-- 客户端注入：内嵌 OpenZenLoader.exe，运行时释放到软件目录 -->
    <EmbeddedResource Include="zen\OpenZenLoader.exe" LogicalName="zen/OpenZenLoader.exe"
                      Condition="Exists('zen\OpenZenLoader.exe')"/>
  </ItemGroup>

</Project>
