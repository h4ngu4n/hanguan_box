<Application x:Class="HanguanBox.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <SolidColorBrush x:Key="TextPrimary" Color="#F2FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="Accent" Color="#5B8CFF"/>
        <SolidColorBrush x:Key="Accent2" Color="#8A5BFF"/>

        <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF5B8CFF" Offset="0"/>
            <GradientStop Color="#FF8A5BFF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

    </Application.Resources>
</Application>
