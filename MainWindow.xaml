<Window x:Class="HanguanBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="寒竿工具箱 Demo"
        Width="1080" Height="680" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="7"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 窗口按钮 -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="#AAFFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#18FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinBtnClose" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左侧导航项：选中 = 薄荷绿底 + 深色文字 -->
        <Style x:Key="NavRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8CFFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="12,9">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#10FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentGrad}"/>
                                <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="16"
            Background="#200D1210"
            BorderBrush="#1FFFFFFF" BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- ======= 标题栏（可拖动，右侧窗口按钮） ======= -->
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Style="{StaticResource WinBtn}" Content="&#xE921;" Click="Min_Click" ToolTip="最小化"/>
                    <Button x:Name="MaxBtn" Style="{StaticResource WinBtn}" Content="&#xE922;" Click="Max_Click" ToolTip="最大化"/>
                    <Button Style="{StaticResource WinBtnClose}" Content="&#xE8BB;" Click="Close_Click" ToolTip="关闭"/>
                </StackPanel>
            </Grid>

            <!-- ======= 主体：左菜单 + 右内容 ======= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧菜单 -->
                <Border Grid.Column="0" CornerRadius="16,0,0,16"
                        BorderBrush="#0FFFFFFF" BorderThickness="0,0,1,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#16FFFFFF" Offset="0"/>
                            <GradientStop Color="#04FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="12,6,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 品牌区 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,8,8,22">
                            <Border Width="34" Height="34" CornerRadius="10"
                                    Background="{StaticResource AccentGrad}">
                                <TextBlock Text="竿" FontSize="15" FontWeight="Bold" Foreground="{StaticResource OnAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="寒竿工具箱" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="HANGUAN BOX" FontSize="9"
                                           Foreground="#66FFFFFF" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 功能导航 -->
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="功能" FontSize="11" Foreground="#52FFFFFF" Margin="14,0,0,8"/>
                            <RadioButton x:Name="NavMcLauncher" Style="{StaticResource NavRadio}" GroupName="nav"
                                         Tag="mclauncher" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Width="26" TextAlignment="Center"/>
                                    <TextBlock Text="下载我的世界启动器" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavHook" Style="{StaticResource NavRadio}" GroupName="nav"
                                         Tag="hook" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Width="26" TextAlignment="Center"/>
                                    <TextBlock Text="注入 HOOK" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavClientInject" Style="{StaticResource NavRadio}" GroupName="nav"
                                         Tag="clientinject" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Width="26" TextAlignment="Center"/>
                                    <TextBlock Text="客户端注入" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavServerForward" Style="{StaticResource NavRadio}" GroupName="nav"
                                         Tag="serverforward" Checked="Nav_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Width="26" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="服务器native转发" VerticalAlignment="Center"/>
                                    <Border Grid.Column="3" x:Name="ForwardBadge" Style="{StaticResource Badge}" Padding="7,2">
                                        <TextBlock x:Name="TxtForwardState" Text="启动中…" Style="{StaticResource BadgeText}"/>
                                    </Border>
                                </Grid>
                            </RadioButton>
                        </StackPanel>

                        <!-- 页脚版本 -->
                        <StackPanel Grid.Row="3" Margin="14,0,0,2">
                            <TextBlock Text="HANGUAN BOX · DEMO" FontSize="10" Foreground="#38FFFFFF"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 右侧内容 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="28,8,28,12" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="下载我的世界启动器" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>

                    <Border Grid.Row="1" Margin="28,0,28,20">
                        <ContentControl x:Name="PageHost" Focusable="False"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
