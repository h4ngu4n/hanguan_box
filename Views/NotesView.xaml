<UserControl x:Class="HanguanBox.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 扁平提示卡：左侧色条 + 纯色底 -->
        <Style x:Key="NoteCard" TargetType="Border" BasedOn="{StaticResource HoverCard}">
            <Setter Property="Padding" Value="0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- 页头 -->
            <StackPanel Margin="0,2,0,16">
                <TextBlock Text="注意事项" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="使用前请先阅读以下内容，可点击各条目右侧按钮前往对应功能。"
                           FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 使用前必读：卸载要求 -->
            <Border Style="{StaticResource NoteCard}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Danger}"/>
                    <StackPanel Grid.Column="1" Margin="18,16">
                        <TextBlock Text="使用前必读" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="· 使用本工具前，必须卸载「网易发烧平台」和「最新版我的世界启动器」，未卸载将无法正常使用相关功能。"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 启动器下载 -->
            <Border Style="{StaticResource NoteCard}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Accent}"/>
                    <StackPanel Grid.Column="1" Margin="18,16">
                        <TextBlock Text="启动器下载" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="· 此版本没有网易发烧平台；下载前必须卸载网易发烧平台和最新版我的世界启动器。"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="· 点击下载后立即开始，安装包保存到软件根目录，完成后可在下载页运行安装程序或打开文件夹。"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="前往下载" Style="{StaticResource GhostBtn}"
                            Command="{Binding NavigateCommand}" CommandParameter="mclauncher"
                            Margin="0,16,16,16" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- 注入 HOOK -->
            <Border Style="{StaticResource NoteCard}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Accent2}"/>
                    <StackPanel Grid.Column="1" Margin="18,16">
                        <TextBlock Text="注入 HOOK" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="· 启动器目录自动查找，也可手动指定；注入状态由内置 DLL 与目录副本的 MD5 对比判定。"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="· 若提示「缺少 DLL」，将 MCL.core.dll 放到软件根目录后重新检测即可。"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="前往注入" Style="{StaticResource GhostBtn}"
                            Command="{Binding NavigateCommand}" CommandParameter="hook"
                            Margin="0,16,16,16" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- 客户端注入 -->
            <Border Style="{StaticResource NoteCard}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Warn}"/>
                    <StackPanel Grid.Column="1" Margin="18,16">
                        <TextBlock Text="客户端注入" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="· 捕捉的对象是正在运行的 Java / Javaw 进程，带窗口的即为图形界面客户端。"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="· 建议先启动游戏再开启「自动刷新（每 3 秒）」，选中进程后进行后续操作。"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="前往扫描" Style="{StaticResource GhostBtn}"
                            Command="{Binding NavigateCommand}" CommandParameter="clientinject"
                            Margin="0,16,16,16" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- 服务器转发 -->
            <Border Style="{StaticResource NoteCard}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Green}"/>
                    <StackPanel Grid.Column="1" Margin="18,16">
                        <TextBlock Text="服务器转发" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="· 软件启动时自动在后台运行转发服务，转发成功后通过 127.0.0.1:25565 访问服务器，退出软件时自动关闭。"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="· 该方式仅对 1.20.1 版本客户端有效，其他版本需使用 ViaFabric 等 mod 修改协议版本。"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="前往管理" Style="{StaticResource GhostBtn}"
                            Command="{Binding NavigateCommand}" CommandParameter="serverforward"
                            Margin="0,16,16,16" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- 免责 -->
            <Border Style="{StaticResource NoteCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Danger}"/>
                    <StackPanel Grid.Column="1" Margin="18,16">
                        <TextBlock Text="免责声明" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="· 本工具仅供学习交流使用，请支持正版 Minecraft；使用本工具产生的任何问题由使用者自行承担。"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
