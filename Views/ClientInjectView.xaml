<UserControl x:Class="HanguanBox.Views.ClientInjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- 页头 -->
            <StackPanel Orientation="Horizontal" Margin="0,2,0,16">
                <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource AccentGrad}">
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource OnAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="客户端注入" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="捕捉正在运行的 Java / Javaw 进程（我的世界 Java 版客户端），为后续注入做准备。"
                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <!-- Java 进程捕获 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                            <TextBlock Text="Java 进程捕获" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border x:Name="StateBadge" Background="#26FFFFFF" CornerRadius="6" Padding="8,2"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtState" Text="未扫描" FontSize="11" Foreground="#99FFFFFF"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="点击「扫描进程」查找所有 java / javaw 进程，带窗口的即为图形界面客户端。"
                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>

                    <Grid Margin="0,12,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnScan" Content="扫描进程" Style="{StaticResource PrimaryBtn}" Click="BtnScan_Click"/>
                            <CheckBox x:Name="ChkAuto" Content="自动刷新（每 3 秒）" FontSize="12"
                                      Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                      Margin="16,0,0,0" Cursor="Hand"
                                      Checked="ChkAuto_Changed" Unchecked="ChkAuto_Changed"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtCount" Text="" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Background="#22000000" CornerRadius="10" Padding="6">
                        <StackPanel>
                            <!-- 表头（与行模板共用列宽） -->
                            <Grid Margin="10,4,10,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PID" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Grid.Column="1" Text="进程" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Grid.Column="2" Text="窗口" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Grid.Column="3" Text="窗口标题" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Grid.Column="4" Text="可执行文件路径" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            </Grid>
                            <Border Height="1" Background="#1FFFFFFF" Margin="4,0,4,2"/>

                            <Grid>
                                <ListBox x:Name="ProcList" Background="Transparent" BorderThickness="0"
                                         FontSize="12" Foreground="{StaticResource TextPrimary}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionMode="Single" Height="190"
                                         SelectionChanged="ProcList_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="bd" CornerRadius="8" Padding="10,7" Margin="0,1"
                                                                Background="Transparent">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#334C8DFF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Pid}" FontFamily="Consolas"
                                                           Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding WindowText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#66FFFFFF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasWindow}" Value="True">
                                                                    <Setter Property="Foreground" Value="#7BE3A8"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="3" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextPrimary}" ToolTip="{Binding Title}"/>
                                                <TextBlock Grid.Column="4" Text="{Binding ExePath}" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextSecondary}" ToolTip="{Binding ExePath}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="TxtEmpty" Text="未发现 java / javaw 进程" FontSize="12"
                                           Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 执行日志 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="执行日志" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                    <Border Background="#22000000" CornerRadius="10" Padding="12">
                        <ScrollViewer x:Name="LogScroll" MaxHeight="190" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtLog" Text="等待操作…" FontSize="12" FontFamily="Consolas"
                                       Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="19"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
