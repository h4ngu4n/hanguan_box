<UserControl x:Class="HanguanBox.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="TileCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="FeedRow" TargetType="Border">
            <Setter Property="Padding" Value="4,10"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="HeroBtn" TargetType="Button">
            <Setter Property="Background" Value="#CCFFFFFF"/>
            <Setter Property="Foreground" Value="#FF3D5BC4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="18,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeroBtnGhost" TargetType="Button" BasedOn="{StaticResource HeroBtn}">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="#66FFFFFF" BorderThickness="1" Padding="18,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- 横幅卡片 -->
            <Border CornerRadius="16" Padding="26" Margin="0,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF5B8CFF" Offset="0"/>
                        <GradientStop Color="#FF8A5BFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="#5B8CFF"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="👋 欢迎使用寒竿工具箱" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="这是一个 WPF 亚克力高斯模糊背景 Demo：窗口后面的桌面内容会被模糊处理，左侧切换菜单，右侧显示对应内容。"
                               Foreground="#E6FFFFFF" Margin="0,8,0,18" TextWrapping="Wrap" FontSize="13"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="开始使用" Style="{StaticResource HeroBtn}" Margin="0,0,10,0"/>
                        <Button Content="查看文档" Style="{StaticResource HeroBtnGhost}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 统计瓦片 -->
            <UniformGrid Columns="3" Margin="0,0,0,16">
                <Border Style="{StaticResource TileCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="在线用户" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                            <TextBlock Text="1,284" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <Border Background="#2634C77B" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="↑ 12%" FontSize="11" Foreground="#7BE3A8"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="今日任务" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                            <TextBlock Text="96" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <Border Background="#2634C77B" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="↑ 4%" FontSize="11" Foreground="#7BE3A8"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TileCard}">
                    <StackPanel>
                        <TextBlock Text="服务可用性" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                            <TextBlock Text="99.9%" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <Border Background="#26F5A623" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="— 持平" FontSize="11" Foreground="#F5C86B"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 近期动态 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="近期动态" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                    <StackPanel>
                        <Border Style="{StaticResource FeedRow}">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#5B8CFF" VerticalAlignment="Center"/>
                                    <TextBlock Text="发布 v0.1.0 演示版本" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="3 分钟前" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource FeedRow}">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#34C77B" VerticalAlignment="Center"/>
                                    <TextBlock Text="新增高斯模糊背景支持（Acrylic）" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="1 小时前" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource FeedRow}">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#F5A623" VerticalAlignment="Center"/>
                                    <TextBlock Text="数据统计页面已上线" Foreground="{StaticResource TextPrimary}" Margin="12,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="昨天 18:24" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
