<UserControl x:Class="HanguanBox.Views.HookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGrad}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="20,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="#66FFFFFF" BorderThickness="1" Padding="20,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- 横幅 -->
            <Border CornerRadius="16" Padding="26" Margin="0,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF5B8CFF" Offset="0"/>
                        <GradientStop Color="#FF8A5BFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="#5B8CFF"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="注入 HOOK" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="自动关闭正在运行的《我的世界》启动器，并将本工具目录内的 MCL.core.dll 放入启动器安装目录。启动器目录会自动查找，也可以手动浏览指定。"
                               Foreground="#E6FFFFFF" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- 启动器目录 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                            <TextBlock Text="启动器目录" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border x:Name="StateBadge" Background="#33F5C86B" CornerRadius="6" Padding="8,2"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtState" Text="检测中…" FontSize="11" Foreground="#F5C86B"/>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="TxtHookPath" Text="正在自动查找启动器目录…" FontSize="12"
                               Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>

                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="注入状态" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <Border x:Name="InjectBadge" Background="#26FFFFFF" CornerRadius="6" Padding="8,2"
                                HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtInjectState" Text="未知" FontSize="11" Foreground="#99FFFFFF"/>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="BtnDetect" Content="自动查找" Style="{StaticResource GhostBtn}" Click="BtnDetect_Click"/>
                        <Button x:Name="BtnBrowse" Content="手动浏览" Style="{StaticResource GhostBtn}" Margin="10,0,0,0" Click="BtnBrowse_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 注入操作 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="执行" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="点击「开始注入」后将先关闭我的世界启动器，再把 MCL.core.dll 复制到启动器目录（覆盖旧文件）。"
                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <Button x:Name="BtnInject" Content="开始注入" Style="{StaticResource PrimaryBtn}"
                            HorizontalAlignment="Left" Margin="0,14,0,0" IsEnabled="False" Click="BtnInject_Click"/>
                </StackPanel>
            </Border>

            <!-- 执行日志 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="执行日志" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                    <Border Background="#22000000" CornerRadius="10" Padding="12">
                        <ScrollViewer x:Name="LogScroll" MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtLog" Text="等待操作…" FontSize="12"
                                       Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="19"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
