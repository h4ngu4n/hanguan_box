<UserControl x:Class="HanguanBox.Views.HookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- 页头 -->
            <StackPanel Margin="0,2,0,16">
                <TextBlock Text="注入 HOOK" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="将内置的 MCL.core.dll 写入启动器目录；目录自动查找，也可手动指定。"
                           FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 启动器目录与注入 -->
            <Border Style="{StaticResource HoverCard}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="启动器目录" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <Border x:Name="StateBadge" Background="#33F5C86B" CornerRadius="6" Padding="8,2"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtState" Text="检测中…" FontSize="11" Foreground="#F5C86B"/>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="TxtHookPath" Text="正在自动查找启动器目录…" FontSize="12"
                               Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>

                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="注入状态" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <Border x:Name="InjectBadge" Background="#26FFFFFF" CornerRadius="6" Padding="8,2"
                                HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtInjectState" Text="未知" FontSize="11" Foreground="#99FFFFFF"/>
                        </Border>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnDetect" Content="自动查找" Style="{StaticResource GhostBtn}" Click="BtnDetect_Click"/>
                        <Button x:Name="BtnBrowse" Content="手动浏览" Style="{StaticResource GhostBtn}"
                                Grid.Column="1" Margin="10,0,0,0" Click="BtnBrowse_Click"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnStartMc" Content="启动 MC" Style="{StaticResource GhostBtn}"
                                    IsEnabled="False" Click="BtnStartMc_Click"/>
                            <Button x:Name="BtnInject" Content="开始注入" Style="{StaticResource PrimaryBtn}"
                                    Margin="10,0,0,0" IsEnabled="False" Click="BtnInject_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 执行日志 -->
            <Border Style="{StaticResource HoverCard}">
                <StackPanel>
                    <TextBlock Text="执行日志" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                    <Border Background="#22000000" CornerRadius="10" Padding="12">
                        <ScrollViewer x:Name="LogScroll" MaxHeight="190" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtLog" Text="等待操作…" FontSize="12" FontFamily="Consolas"
                                       Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="19"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
