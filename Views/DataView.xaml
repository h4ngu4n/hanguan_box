<UserControl x:Class="HanguanBox.Views.DataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 汇总卡片 -->
        <UniformGrid Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="本周总量" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="1,024" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="日均" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="146" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="峰值" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="231" FontSize="18" FontWeight="Bold" Foreground="#9BB8FF" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <TextBlock Text="环比" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="+8.6%" FontSize="18" FontWeight="Bold" Foreground="#7BE3A8" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 柱状图 -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="4,0,4,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="近 7 天数据" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock Text="已完成" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="6,0,16,0"/>
                        <Ellipse Width="9" Height="9" Fill="{StaticResource Accent2}" VerticalAlignment="Center"/>
                        <TextBlock Text="目标" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>

                <ItemsControl Grid.Row="1" x:Name="Bars">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid VerticalAlignment="Bottom">
                                    <Border Height="{Binding TargetHeight}" CornerRadius="8,8,0,0"
                                            Background="#26FFFFFF" VerticalAlignment="Bottom"/>
                                    <Border Height="{Binding ValueHeight}" CornerRadius="8,8,0,0"
                                            VerticalAlignment="Bottom" ToolTip="{Binding Value}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FF5B8CFF" Offset="0"/>
                                                <GradientStop Color="#FF8A5BFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="12" Margin="0,8,0,0"
                                           Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
