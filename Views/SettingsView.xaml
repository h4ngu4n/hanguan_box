<UserControl x:Class="HanguanBox.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 开关 -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="26">
                            <Border x:Name="track" CornerRadius="13" Background="#2EFFFFFF"/>
                            <Border x:Name="thumb" Width="20" Height="20" CornerRadius="10"
                                    Background="#E6FFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#FF5B8CFF"/>
                                <Setter TargetName="thumb" Property="Margin" Value="23,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="12,6"
                                BorderBrush="#1FFFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E5B8CFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Padding" Value="4,12"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- 外观 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="外观" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>

                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="亚克力高斯模糊" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                                <TextBlock Text="对窗口后面的桌面内容应用模糊效果" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="True"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="开机自启动" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                                <TextBlock Text="登录 Windows 时自动运行本程序" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="桌面通知" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                                <TextBlock Text="任务完成或出错时弹出系统通知" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="True"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingRow}" BorderThickness="0" Padding="4,12,4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="主题" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                                <TextBlock Text="选择界面主题风格" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton Style="{StaticResource PillRadio}" GroupName="theme" Content="浅色"/>
                                <RadioButton Style="{StaticResource PillRadio}" GroupName="theme" Content="深色" IsChecked="True"/>
                                <RadioButton Style="{StaticResource PillRadio}" GroupName="theme" Content="跟随系统"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="关于" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>

                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <TextBlock Text="检查更新" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                            <TextBlock Text="当前已是最新版本 v0.1.0" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0" Padding="4,12,4,0">
                        <Grid>
                            <TextBlock Text="技术栈" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                            <TextBlock Text=".NET 10 · WPF · DWM Acrylic" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
