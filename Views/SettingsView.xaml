<UserControl x:Class="HanguanBox.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- 自定义背景 -->
            <Border Style="{StaticResource HoverCard}" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="自定义背景" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="选择一张图片作为全局背景，配合毛玻璃（高斯模糊）与压暗层保证文字可读；切换时自动淡入淡出过渡。"
                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>

                    <TextBlock Text="当前图片" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,12,0,4"/>
                    <Border Background="#22000000" CornerRadius="8" Padding="10,7">
                        <TextBlock x:Name="TxtBgPath" Text="未设置（使用默认深色背景）" FontSize="12"
                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding BackgroundPath}"/>
                    </Border>

                    <!-- 模糊半径 -->
                    <TextBlock Text="背景模糊强度" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,14,0,4"/>
                    <Slider x:Name="SldBlur" Minimum="0" Maximum="80" Value="{Binding BackgroundBlurRadius, Mode=OneWay}"
                            IsMoveToPointEnabled="True" TickFrequency="5" IsSnapToTickEnabled="False"
                            ValueChanged="SldBlur_ValueChanged"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="选择图片" Style="{StaticResource PrimaryBtn}" Click="PickBg_Click"/>
                        <Button Content="恢复默认" Style="{StaticResource GhostBtn}" Margin="10,0,0,0" Click="ClearBg_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource HoverCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="关于" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="寒竿工具箱 Demo · HANGUAN BOX" FontSize="12"
                               Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                    <TextBlock Text="基于 WPF (.NET 10) 构建，界面融合 Fluent Design 与 Material Design 元素：无边框圆角窗口、深色模式、蓝/青强调色、页面切换与悬停动画。"
                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="UI 基础库：MaterialDesignInXamlToolkit · MVVM：CommunityToolkit.Mvvm"
                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
