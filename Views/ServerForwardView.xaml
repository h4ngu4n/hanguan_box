<UserControl x:Class="HanguanBox.Views.ServerForwardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- 页头 -->
            <StackPanel Margin="0,2,0,16">
                <TextBlock Text="服务器 native 转发" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="软件启动时自动在后台运行转发服务，转发成功后即可通过 127.0.0.1:25565 访问服务器，可在此页面关闭或重新启动。"
                           FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 服务状态 -->
            <Border Style="{StaticResource HoverCard}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="转发服务" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <Border x:Name="StateBadge" Background="#26FFFFFF" CornerRadius="6" Padding="8,2"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtState" Text="检测中…" FontSize="11" Foreground="#99FFFFFF"/>
                        </Border>
                    </Grid>

                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="监听地址" FontSize="12"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            <Border Background="#22000000" CornerRadius="6" Padding="8,3" Margin="10,0,0,0">
                                <TextBlock x:Name="TxtAddress" Text="127.0.0.1:25565" FontSize="12" FontFamily="Consolas"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </Border>
                        </StackPanel>
                        <Button x:Name="BtnCopy" Content="复制地址" Style="{StaticResource GhostBtn}"
                                HorizontalAlignment="Right" Click="BtnCopy_Click"/>
                    </Grid>

                    <TextBlock Text="转发完成后会弹窗提示，并自动复制访问地址到剪贴板。注意：该方式仅对 1.20.1 版本客户端有效，其他版本客户端需使用 ViaFabric 等 mod 修改协议版本。"
                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,10,0,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="BtnStart" Content="启动服务" Style="{StaticResource GhostBtn}"
                                IsEnabled="False" Click="BtnStart_Click"/>
                        <Button x:Name="BtnStop" Content="关闭服务" Style="{StaticResource PrimaryBtn}"
                                Margin="10,0,0,0" IsEnabled="False" Click="BtnStop_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 执行日志 -->
            <Border Style="{StaticResource HoverCard}">
                <StackPanel>
                    <TextBlock Text="服务日志" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                    <Border Background="#22000000" CornerRadius="10" Padding="12">
                        <ScrollViewer x:Name="LogScroll" MaxHeight="190" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtLog" Text="等待操作…" FontSize="12" FontFamily="Consolas"
                                       Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="19"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
