<UserControl x:Class="HanguanBox.Views.McLauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGrad}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="20,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="#66FFFFFF" BorderThickness="1" Padding="20,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- 下载横幅 -->
            <Border CornerRadius="16" Padding="26" Margin="0,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF5B8CFF" Offset="0"/>
                        <GradientStop Color="#FF8A5BFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="#5B8CFF"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="我的世界启动器下载" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="一键下载《我的世界》Windows 版启动器官方安装包，保存到本工具所在根目录，下载完成后运行安装程序即可。"
                               Foreground="#E6FFFFFF" Margin="0,8,0,18" TextWrapping="Wrap" FontSize="13"/>
                    <Button x:Name="BtnDownload" Content="下载启动器" Style="{StaticResource PrimaryBtn}"
                            HorizontalAlignment="Left" Click="BtnDownload_Click"/>
                </StackPanel>
            </Border>

            <!-- 下载须知（页面内提示，非弹窗） -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="#F5C86B" VerticalAlignment="Center"/>
                        <TextBlock Text="下载须知" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="· 此版本没有网易发烧平台。" FontSize="12" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                    <TextBlock Text="· 下载之前，需要卸载最新版本网易发烧平台；如果您已经安装过，可以忽略此提示。"
                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="· 点击「下载启动器」后立即开始下载，安装包保存到软件根目录。"
                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 下载进度 -->
            <Border x:Name="ProgressCard" Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtFileName" Text="正在获取下载信息…" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtPercent" Text="0%" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right"/>
                    </Grid>

                    <ProgressBar x:Name="Bar" Height="8" Minimum="0" Maximum="100" Value="0"
                                 Background="#22FFFFFF" Foreground="{StaticResource AccentGrad}"
                                 BorderThickness="0"/>

                    <Grid Margin="0,10,0,0">
                        <TextBlock x:Name="TxtSize" Text="" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtSpeed" Text="速度：--" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="TxtEta" Text="" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="BtnCancel" Content="取消下载" Style="{StaticResource GhostBtn}"
                            HorizontalAlignment="Right" Margin="0,14,0,0" Click="BtnCancel_Click"/>
                </StackPanel>
            </Border>

            <!-- 错误提示 -->
            <Border x:Name="ErrorCard" Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="Collapsed"
                    BorderBrush="#66E81123">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="#FF6B6B" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtError" Text="下载失败" Foreground="#FF9C9C" Margin="10,0,0,0"
                               FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 下载完成 -->
            <Border x:Name="DoneCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="#34C77B" VerticalAlignment="Center"/>
                        <TextBlock Text="下载完成！" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="安装包已保存到软件根目录，请运行安装程序并按提示操作，本工具将等待您完成安装。"
                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,4" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtSavedPath" Text="" FontSize="11" Foreground="{StaticResource TextSecondary}"
                               Margin="0,2,0,14" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="运行安装程序" Style="{StaticResource PrimaryBtn}"
                                Margin="0,0,10,0" Click="BtnRunInstaller_Click"/>
                        <Button Content="打开文件夹" Style="{StaticResource GhostBtn}" Click="BtnOpenFolder_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
