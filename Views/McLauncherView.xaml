<UserControl x:Class="HanguanBox.Views.McLauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- 下载横幅 -->
            <Border CornerRadius="16" Padding="22" Margin="0,0,0,14" Background="{StaticResource AccentGrad}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.32" Color="#4C8DFF"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="我的世界启动器下载" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="一键下载官方 Windows 启动器，安装包保存到软件根目录，下载完成后运行安装程序即可。"
                               Foreground="#E6FFFFFF" Margin="0,6,0,14" TextWrapping="Wrap" FontSize="12"/>
                    <Button x:Name="BtnDownload" Content="下载启动器" Style="{StaticResource PrimaryBtn}"
                            HorizontalAlignment="Left" Click="BtnDownload_Click"/>
                </StackPanel>
            </Border>

            <!-- 下载须知 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#8FC1FF" VerticalAlignment="Center"/>
                        <TextBlock Text="下载须知" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="· 此版本没有网易发烧平台；下载前需卸载最新版本网易发烧平台，已安装过可忽略。"
                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                    <TextBlock Text="· 点击下载后立即开始，完成后可在下方运行安装程序或打开文件夹。"
                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 下载进度 -->
            <Border x:Name="ProgressCard" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtFileName" Text="正在获取下载信息…" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtPercent" Text="0%" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right"/>
                    </Grid>

                    <ProgressBar x:Name="Bar" Height="6" Minimum="0" Maximum="100" Value="0"
                                 Background="#22FFFFFF" Foreground="{StaticResource AccentGrad}"
                                 BorderThickness="0"/>

                    <Grid Margin="0,8,0,0">
                        <TextBlock x:Name="TxtSize" Text="" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtSpeed" Text="速度：--" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="TxtEta" Text="" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="BtnCancel" Content="取消下载" Style="{StaticResource GhostBtn}"
                            HorizontalAlignment="Right" Margin="0,12,0,0" Click="BtnCancel_Click"/>
                </StackPanel>
            </Border>

            <!-- 错误提示 -->
            <Border x:Name="ErrorCard" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed"
                    BorderBrush="#66E81123">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="#FF6B6B" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtError" Text="下载失败" Foreground="#FF9C9C" Margin="9,0,0,0"
                               FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 下载完成 -->
            <Border x:Name="DoneCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#34C77B" VerticalAlignment="Center"/>
                        <TextBlock Text="下载完成！" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="9,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtSavedPath" Text="" FontSize="11" Foreground="{StaticResource TextSecondary}"
                               Margin="0,6,0,12" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="运行安装程序" Style="{StaticResource PrimaryBtn}"
                                Margin="0,0,10,0" Click="BtnRunInstaller_Click"/>
                        <Button Content="打开文件夹" Style="{StaticResource GhostBtn}" Click="BtnOpenFolder_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
